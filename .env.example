# Required in production (set in the Vercel project, never commit real values)
APP_SECRET=                  # >= 32 random characters; signs OAuth tokens and seals one-time key reveals
PUBLIC_BASE_URL=             # e.g. https://connectors.thefiredev.com (no trailing slash)
BLOB_READ_WRITE_TOKEN=       # private Vercel Blob store (keys, usage counters, OAuth state)
STRIPE_SECRET_KEY=           # sk_/rk_ key; use test-mode keys until you go live
STRIPE_WEBHOOK_SECRET=       # whsec_ for the endpoint https://<host>/api/stripe/webhook
STRIPE_PRICE_PRO=            # price_ id of the Pro monthly price

# Optional
OPENFDA_API_KEY=             # raises the openFDA rate limit (free key from open.fda.gov)
HF_TOKEN=                    # Hugging Face read token for gated repos and higher rate limits
PROTOCOL_GUIDE_BASE_URL=     # default https://protocol-guide.com
JUDGEFINDER_BASE_URL=        # default https://judgefinder.vercel.app

# Local development only
LOCAL_STORE_DIR=.local-store # file-backed store instead of Blob (pnpm dev sets this by default)
PORT=8787
